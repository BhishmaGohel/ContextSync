{
  "manifest_version": 3,
  "name": "Master Prompt Injector Pro",
  "version": "2.0.0",
  "description": "Enterprise-grade Master Prompt injector with sync-backed storage and a management dashboard.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://perplexity.ai/*",
    "https://chat.mistral.ai/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://search.brave.com/*",
    "https://perplexity.ai",
    "https://search.brave.com/*",
    "https://duck.ai/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://perplexity.ai/*",
        "https://chat.mistral.ai/*",
        "https://claude.ai/*",
        "https://chatgpt.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
