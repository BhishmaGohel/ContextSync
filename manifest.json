{
  "manifest_version": 3,
  "name": "Master Prompt Injector Pro",
  "version": "2.0.0",
  "description": "Enterprise-grade Master Prompt injector with sync-backed storage and a management dashboard.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://perplexity.ai/*",
    "https://chat.mistral.ai/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://search.brave.com/*",
    "https://duck.ai/*",
    "https://x.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_popup": "dist/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://perplexity.ai/*",
        "https://chat.mistral.ai/*",
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://search.brave.com/*",
        "https://duck.ai/*",
        "https://x.com/*" 
      ],
      "js": ["dist/content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
  ,
  "options_page": "dist/dashboard.html",
  "web_accessible_resources": [
    {
      "resources": ["dist/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
